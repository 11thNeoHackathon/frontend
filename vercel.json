{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/demo/?$",
      "dest": "/index.html"
    },
    {
      "src": "/api/v1/(.*)",
      "has": [
        {
          "type": "header",
          "key": "sec-fetch-site",
          "value": "same-origin"
        }
      ],
      "dest": "https://3.104.111.132/api/v1/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": { "key": "origin" }
        }
      ]
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "https://3.104.111.132/api/v1/$1"
    }
  ]
}
